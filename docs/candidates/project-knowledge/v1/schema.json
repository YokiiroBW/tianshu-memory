{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tianshu:candidate:project-knowledge:1",
  "title": "Project knowledge CLI envelope candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "project_id",
    "arguments"
  ],
  "properties": {
    "operation": {
      "enum": [
        "query",
        "recover",
        "import",
        "write_state",
        "delete",
        "check",
        "status"
      ]
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "arguments": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "query",
              "recover"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "budget_bytes"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "budget_bytes": {
                "type": "integer",
                "minimum": 256,
                "maximum": 32768
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "recover"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "properties": {
              "budget_bytes": {
                "minimum": 1024
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "import"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "kind",
              "locator",
              "expected_version",
              "groups"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "kind": {
                "enum": [
                  "file",
                  "url"
                ]
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "expected_version": {
                "type": "integer",
                "minimum": 0
              },
              "groups": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 128,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "start",
                        "end",
                        "depends_on"
                      ],
                      "properties": {
                        "start": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "depends_on": {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "write_state"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "expected_version",
              "state"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "expected_version": {
                "type": "integer",
                "minimum": 0
              },
              "state": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "goal",
                  "constraints",
                  "recent_verification",
                  "unfinished",
                  "evidence",
                  "pitfalls"
                ],
                "properties": {
                  "goal": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "constraints": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "maxItems": 16,
                    "minItems": 0
                  },
                  "recent_verification": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "maxItems": 16,
                    "minItems": 0
                  },
                  "unfinished": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "maxItems": 16,
                    "minItems": 0
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "block_id",
                        "document_id",
                        "version",
                        "hash"
                      ],
                      "properties": {
                        "block_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048
                        },
                        "document_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048
                        },
                        "version": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "hash": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      }
                    },
                    "maxItems": 16,
                    "minItems": 1
                  },
                  "pitfalls": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "trigger",
                        "symptom",
                        "cause",
                        "correction",
                        "verification",
                        "evidence"
                      ],
                      "properties": {
                        "trigger": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1000
                        },
                        "symptom": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1000
                        },
                        "cause": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1000
                        },
                        "correction": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1000
                        },
                        "verification": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1000
                        },
                        "evidence": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "block_id",
                              "document_id",
                              "version",
                              "hash"
                            ],
                            "properties": {
                              "block_id": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 2048
                              },
                              "document_id": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 2048
                              },
                              "version": {
                                "type": "integer",
                                "minimum": 1
                              },
                              "hash": {
                                "type": "string",
                                "pattern": "^[a-f0-9]{64}$"
                              }
                            }
                          },
                          "maxItems": 16,
                          "minItems": 1
                        }
                      }
                    },
                    "maxItems": 8,
                    "minItems": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "delete"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "expected_version",
              "document_id"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "expected_version": {
                "type": "integer",
                "minimum": 0
              },
              "document_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "check"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "package"
            ],
            "properties": {
              "package": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "status"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      }
    }
  ]
}
